import Icosahedron.KCheck

/-!
# Certificate generator for the complex case

Runs the same `KCheck` functions as the kernel and writes, for each pair of charts, the
hexadecimal tree consumed by `csearchD`, into `Icosahedron/CertC/P<i><j>.lean`.
Usage: `lake exe gen <outdir>`.
-/

open Icosahedron.K

def toF (x : ZP) : Float :=
  (x.ap.toFloat - x.an.toFloat) + (x.bp.toFloat - x.bn.toFloat) * 1.6180339887498949

/-- Candidate pairs: the three faces with largest low end times the three with smallest
high end at the centre (the heuristic pair first). -/
def cands (A : Nat → V3 P6) (W : Nat → Nat → V3 P6) : List (Nat × Nat) :=
  let los := (List.range 10).map fun i => (i, toF (lo A W i))
  let his := (List.range 10).map fun i => (i, toF (hi A W i))
  let t1 := ((los.mergeSort fun a b => decide (a.2 ≥ b.2)).take 3).map (·.1)
  let t2 := ((his.mergeSort fun a b => decide (a.2 ≤ b.2)).take 3).map (·.1)
  (t1.flatMap fun i => t2.map fun j => (i, j)).filter fun p => p.1 != p.2

def findLeaf (ch1 ch2 : Nat) (c : CCell) : Option (List Nat) := Id.run do
  let A := blockA ch1 c.ju c.jv c.m1
  let B := blockB ch2 c.ku c.kv c.m2
  for n in List.range 16 do
    let (xs, x, y, d) := phase n
    for (i1, i2) in cands A (wAt B xs x y false 0) do
      if zpairOK A B xs x y true d false d i1 i2 then return some [1, n, i1, i2]
  for n in List.range 16 do
    let (xs, x, y, d) := phase n
    let mut first : Option (Nat × Nat) := none
    for (i1, i2) in cands A (wAt B xs (2 * x) (2 * y) true d) do
      if first.isNone && zpairOK A B xs x y true d false 0 i1 i2 then first := some (i1, i2)
    if let some (i1, i2) := first then
      for (j1, j2) in cands A (wAt B xs (2 * x) (2 * y) false d) do
        if zpairOK A B xs x y false 0 false d j1 j2 then return some [2, n, i1, i2, j1, j2]
  return none

structure Stats where
  leaf1 : Nat := 0
  leaf2 : Nat := 0
  splits : Nat := 0
  maxLevel : Nat := 0

partial def gen (ch1 ch2 : Nat) (c : CCell) (fuel : Nat) (st : Stats) :
    Except String (List Nat × Stats) := do
  if let some ds := findLeaf ch1 ch2 c then
    let st := if ds.head? == some 1 then { st with leaf1 := st.leaf1 + 1 }
      else { st with leaf2 := st.leaf2 + 1 }
    return (ds, { st with maxLevel := max st.maxLevel (c.m1 + c.m2) })
  if fuel = 0 then throw s!"no certificate at {c.ju} {c.jv} {c.m1} {c.ku} {c.kv} {c.m2}"
  let kids : List CCell :=
    if c.m1 ≤ c.m2 then
      let a := 2 * c.ju; let b := 2 * c.jv; let m := c.m1 + 1
      [⟨a, b, m, c.ku, c.kv, c.m2⟩, ⟨a + 1, b, m, c.ku, c.kv, c.m2⟩,
        ⟨a, b + 1, m, c.ku, c.kv, c.m2⟩, ⟨a + 1, b + 1, m, c.ku, c.kv, c.m2⟩]
    else
      let a := 2 * c.ku; let b := 2 * c.kv; let m := c.m2 + 1
      [⟨c.ju, c.jv, c.m1, a, b, m⟩, ⟨c.ju, c.jv, c.m1, a + 1, b, m⟩,
        ⟨c.ju, c.jv, c.m1, a, b + 1, m⟩, ⟨c.ju, c.jv, c.m1, a + 1, b + 1, m⟩]
  let mut out := [0]
  let mut st := { st with splits := st.splits + 1 }
  for k in kids do
    let (ds, st') ← gen ch1 ch2 k (fuel - 1) st
    out := out ++ ds
    st := st'
  return (out, st)

def digitsToNat (ds : List Nat) : Nat := ds.foldr (fun d acc => d + 16 * acc) 0

def hex (n : Nat) : String := "0x" ++ String.ofList (Nat.toDigits 16 n)

def fileText (i j : Nat) (n : Nat) (st : Stats) : String :=
  s!"import Icosahedron.KCheck

/-! Generated by `lake exe gen`: chart pair ({i}, {j}); leaves of type 1: {st.leaf1}, of type 2: {st.leaf2}, splits: {st.splits}, max level: {st.maxLevel}. -/

namespace Icosahedron.K

def treeC{i}{j} : Nat :=
  {hex n}

set_option maxRecDepth 100000 in
theorem certC{i}{j} : (csearchD {i} {j} 40 ⟨0, 0, 0, 0, 0, 0⟩ treeC{i}{j}).isSome = true := by
  decide +kernel

end Icosahedron.K
"

def realText (ch : Nat) (sg : Bool) : String :=
  let t := if sg then "t" else "f"
  s!"import Icosahedron.KCheck

/-! Generated by `lake exe gen real`: real case, chart {ch}, sign {sg}. -/

namespace Icosahedron.K

set_option maxRecDepth 100000 in
theorem certR{ch}{t} : rsearch {ch} {sg} 40 ⟨0, 0, 0, 0, 0⟩ = true := by
  decide +kernel

end Icosahedron.K
"

def allText : String := Id.run do
  let mut s := "import Icosahedron.KCheck\n"
  for ch in List.range 6 do
    for t in ["f", "t"] do
      s := s ++ s!"import Icosahedron.CertR.R{ch}{t}\n"
  for i in List.range 6 do
    for j in List.range 6 do
      s := s ++ s!"import Icosahedron.CertC.P{i}{j}\n"
  s := s ++ "
/-! Generated by `lake exe gen real`: all kernel certificates. -/

namespace Icosahedron.K

theorem real_all (ch : Nat) (hch : ch < 6) (sg : Bool) :
    rsearch ch sg 40 ⟨0, 0, 0, 0, 0⟩ = true := by
  rcases ch with _ | _ | _ | _ | _ | _ | ch
"
  for ch in List.range 6 do
    s := s ++ s!"  · cases sg\n    · exact certR{ch}f\n    · exact certR{ch}t\n"
  s := s ++ "  · omega

theorem complex_all (ch1 ch2 : Nat) (h1 : ch1 < 6) (h2 : ch2 < 6) :
    ∃ s s', csearchD ch1 ch2 40 ⟨0, 0, 0, 0, 0, 0⟩ s = some s' := by
  rcases ch1 with _ | _ | _ | _ | _ | _ | ch1
"
  for i in List.range 6 do
    s := s ++ "  · rcases ch2 with _ | _ | _ | _ | _ | _ | ch2\n"
    for j in List.range 6 do
      s := s ++ s!"    · exact ⟨treeC{i}{j}, Option.isSome_iff_exists.1 certC{i}{j}⟩\n"
    s := s ++ "    · omega\n"
  s := s ++ "  · omega

end Icosahedron.K
"
  return s

def main (args : List String) : IO UInt32 := do
  if args.headD "" == "real" then
    for ch in List.range 6 do
      for sg in [false, true] do
        IO.FS.writeFile s!"Icosahedron/CertR/R{ch}{if sg then "t" else "f"}.lean" (realText ch sg)
    IO.FS.writeFile "Icosahedron/CertAll.lean" allText
    return 0
  let outdir := args.headD "Icosahedron/CertC"
  let pairs := (List.range 6).flatMap fun i => (List.range 6).map fun j => (i, j)
  let pairs := match args with
    | [_, a, b] => [(a.toNat!, b.toNat!)]
    | _ => pairs
  let tasks ← pairs.mapM fun (i, j) => IO.asTask (prio := .dedicated) do
    match gen i j ⟨0, 0, 0, 0, 0, 0⟩ 40 {} with
    | .error e => throw (IO.userError s!"pair {i} {j}: {e}")
    | .ok (ds, st) =>
      let n := digitsToNat ds
      -- self-check with the kernel function itself
      unless (csearchD i j 40 ⟨0, 0, 0, 0, 0, 0⟩ n).isSome do
        throw (IO.userError s!"pair {i} {j}: csearchD rejects the generated tree")
      IO.FS.writeFile s!"{outdir}/P{i}{j}.lean" (fileText i j n st)
      return (i, j, st, ds.length)
  let mut ok := true
  for t in tasks do
    match t.get with
    | .error e => IO.println s!"ERROR {e}"; ok := false
    | .ok (i, j, st, len) =>
      IO.println s!"pair {i} {j}: leaf1 {st.leaf1} leaf2 {st.leaf2} splits {st.splits} maxlevel {st.maxLevel} digits {len}"
  return if ok then 0 else 1
